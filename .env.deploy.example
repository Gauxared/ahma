# Пример окружения для демонстрационного стека.
# Скопировать в .env рядом с docker-compose.deploy.yml и заполнить.

# Пароли РАЗНЫЕ у владельца схемы и у роли приложения: на этом держится RLS.
# Приложение не должно уметь менять схему — иначе ограничение роли, которым
# обеспечена изоляция арендатора, перестаёт быть ограничением.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Профиль развёртывания. `single-tenant-onprem` запрещает второго арендатора
# на уровне приложения (ADR-R-015).
DEPLOYMENT_PROFILE=single-tenant-onprem

# Внешняя модель (этап 1). Ключ НЕ коммитится.
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=

# ВЫХОД НАРУЖУ ЧЕРЕЗ ТУННЕЛЬ — заполнять, только если провайдер модели
# недоступен с адреса машины напрямую.
#
# Замерено 06.09.2026 на app.strintel.ru: openrouter.ai отдаёт с адреса сервера
# `403 Access denied by security policy` (заголовки `server: cloudflare`,
# `cf-ray: …-DME`) — при том же ключе, который с машины владельца отвечает 200.
# Блокирован адрес, а не ключ: проверено curl, node fetch без заголовков и node
# fetch с браузерным User-Agent. Через локальный вход sing-box тот же запрос
# проходит и модель отвечает.
#
# ЭТО НЕ ПРОСТО СЕТЕВАЯ НАСТРОЙКА, А ИЗМЕНЕНИЕ МАРШРУТА ВЫХОДА. Данные идут не
# напрямую в объявленное назначение, а через хост туннеля — и он видит трафик
# до выхода. Поэтому адрес входа записывается здесь, а не остаётся known-how
# одной машины: §12.1л требует, чтобы путь данных наружу читался по
# конфигурации, а не восстанавливался расспросами.
HTTPS_PROXY=
HTTP_PROXY=

# ЧТО В ТУННЕЛЬ НЕ ОТДАЁТСЯ — и это обязательная часть, а не удобство.
#
# Назначения внутреннего маршрута из config/extensions/model-routes.json
# (`in-contour-model-route`) существуют ровно затем, чтобы данные НЕ покидали
# контур. Уйдя в туннель, они покинули бы его через чужой хост — то есть
# внутренний контур перестал бы быть внутренним, оставаясь так объявленным.
#
# Список сверяется набором tooling/deploy-proxy.test.ts: назначение, добавленное
# во внутренний маршрут и забытое здесь, останавливает сборку.
NO_PROXY=127.0.0.1,localhost,vllm.internal,host.docker.internal

# Папка с объектами заказчика на хосте. Монтируется только на чтение.
# Где лежат документы заказчика НА ХОСТЕ. Compose монтирует этот каталог в
# контейнер только на чтение: образ уезжает в реестр, а сметы заказчика там не
# место (ТЗ §11).
OBJECTS_PATH=./var/objects

# Где приложение ХРАНИТ загруженное — путь ВНУТРИ контейнера или на машине при
# запуске без Docker. Имя одно на весь код: раньше здесь было три разных, и
# работало то, которое никто не задавал.
STROYINTELLECT_OBJECTS_PATH=/data/objects

# Имя стека. У КАЖДОЙ установки своё: si-demo, si-stage, si-apri.
#
# Совпадение имён означает, что compose переиспользует чужие контейнеры и тома
# как свои. В лучшем случае это отказ миграций, в худшем — успешная миграция
# чужой базы.
COMPOSE_PROJECT_NAME=si-demo

WEB_PORT=3000
TAG=dev
