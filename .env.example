# ─── База данных ───────────────────────────────────────────────────────────
# Владелец схемы: миграции и провизионирование. НЕ использовать в приложении.
DATABASE_OWNER_URL=postgresql://stroyintellect:stroyintellect@127.0.0.1:5432/stroyintellect

# Приложение: ограниченная роль без BYPASSRLS. Только на неё действует изоляция
# арендатора (ADR-R-015). Пароль выдаётся tooling/provision-db-role.ts.
DATABASE_URL=postgresql://stroyintellect_app:ЗАДАТЬ@127.0.0.1:5432/stroyintellect
STROYINTELLECT_DB_APP_PASSWORD=ЗАДАТЬ

# ─── Профиль развёртывания ─────────────────────────────────────────────────
# single-tenant-onprem | multi-tenant | development
# Для АПРИ обязателен single-tenant-onprem: данные остаются в контуре заказчика (ТЗ §6.1)
STROYINTELLECT_DEPLOYMENT_PROFILE=development

# ─── Модели ────────────────────────────────────────────────────────────────
# Потолок возможностей целевой ЛОКАЛЬНОЙ модели применяется и к внешнему
# провайдеру, чтобы разрыв не копился незаметно (ADR-R-020)
STROYINTELLECT_MODEL_PROFILE=target-local

# OpenAI-совместимый endpoint — базовый адаптер (ADR-R-004)
STROYINTELLECT_MODEL_BASE_URL=
STROYINTELLECT_MODEL_API_KEY=
STROYINTELLECT_MODEL_ID=
# Глубина рассуждения модели: low | medium | high | xhigh | max.
# Пусто — поле не отправляется вовсе. Умолчания нет намеренно: локальная модель
# в контуре (второй этап) может ответить на незнакомое поле отказом.
STROYINTELLECT_MODEL_REASONING_EFFORT=

# ─── Экипаж на Codex SDK (docs/spec-demo-stage-1.md) ─────────────────────────
# Режим прогона «агенты»: те же адрес, модель и ключ, что выше. Всё ниже —
# необязательно. Дом Codex — НЕ ~/.codex (личные навыки пользователя) и НЕ /tmp
# (двоичный файл отказывается заводить там служебные ссылки).
STROYINTELLECT_CODEX_HOME=
# Рабочие папки прогонов: разобранные сметы, тексты, ответы ролей.
STROYINTELLECT_CODEX_RUNS=
# Потолок одного хода роли в минутах (по умолчанию 20).
STROYINTELLECT_CODEX_TURN_MINUTES=
# Веб-поиск модели: 1 — включить. По умолчанию выключен, сеть треда закрыта.
STROYINTELLECT_CODEX_WEB_SEARCH=
# Песочница команд роли: read-only (умолчание) | workspace-write | danger-full-access.
# Песочница Codex на Linux — bubblewrap с пользовательскими пространствами имён;
# Ubuntu 24.04 запрещает их по умолчанию (kernel.apparmor_restrict_unprivileged_userns=1),
# и тогда ни одна команда роли не выполняется. Либо разрешить userns на площадке,
# либо объявить здесь danger-full-access — команды пойдут без ограничений.
STROYINTELLECT_CODEX_SANDBOX=

# Нормативные документы текстом — своды правил и ГОСТы (Т12). Извлекаются один
# раз `tooling/extract-normative.ts` и живут ВНЕ выпусков: на сервере это
# /opt/stroyintellekt/var/нормативка, потому что каталог выпуска пересоздаётся,
# а 47 МБ сводов от выпуска к выпуску не меняются.
STROYINTELLECT_NORMATIVE_DIR=

# ─── Любой вход (spec-demo-stage-1 А11) ───────────────────────────────────────
# Потолок книги Excel для разбора, МБ (по умолчанию 8). Книга больше потолка
# принимается, но разбирается только текстом рабочей папки экипажа.
STROYINTELLECT_SHEET_MAX_MB=

# ─── Границы передачи данных ───────────────────────────────────────────────
# ЛИСТЫ ЧЕРТЕЖЕЙ КАРТИНКОЙ. Изображение обезличиванию не подлежит: фамилии
# проектировщиков стоят в штампе растром (§8.3, §12.1л). По умолчанию не
# отправляются никуда.
#
# `STROYINTELLECT_LOCAL_MODEL=да` — владелец подтверждает, что за локальным
# адресом стоит МОДЕЛЬ, а не шлюз наружу. Код этого не проверит: llama.cpp и
# прокси к Gemini выглядят на 127.0.0.1 одинаково. Без подтверждения локальный
# адрес отправку НЕ разрешает.
#
# `STROYINTELLECT_VISION_EXTERNAL=да` — владелец разрешает отправку листов на
# внешнюю модель НЕОБЕЗЛИЧЕННЫМИ. Именно так работает демонстрационный контур:
# анализируются открытые документы.
STROYINTELLECT_LOCAL_MODEL=
STROYINTELLECT_VISION_EXTERNAL=

# ─── Потолки промпта ───────────────────────────────────────────────────────
# Поставлены под целевую локальную модель (окно 32k). На внешних моделях с окном
# 200k они урезают пайплайн без нужды: подшивка РД сжимается, листов уходит три.
# Демонстрационный контур поднимает их: 200000 знаков и 12 листов.
STROYINTELLECT_DESIGN_TEXT_CHARS=
STROYINTELLECT_DESIGN_SHEETS=

# ─── Потолки одновременности ───────────────────────────────────────────────
# Агенты (Д5) и обход папки. Пусто — четыре у обоих.
STROYINTELLECT_AGENT_CONCURRENCY=
STROYINTELLECT_WALK_CONCURRENCY=

# Где приложение хранит загруженные документы заказчика. Без него — `var/objects`
# рядом с кодом: годится для разработки, но не для сервера, где документы обязаны
# лежать отдельно от поставки (ТЗ §11).
STROYINTELLECT_OBJECTS_PATH=

# Поиск для ролей экипажа (`инструменты/поиск`). С адреса сервера поисковики отдают
# CAPTCHA или подставную выдачу; через прокси DuckDuckGo отвечает настоящей.
# На сервере: http://127.0.0.1:2080 (sing-box). Ключи API — необязательные каналы.
STROYINTELLECT_SEARCH_PROXY=
STROYINTELLECT_BRAVE_SEARCH_KEY=
STROYINTELLECT_SERPER_KEY=
STROYINTELLECT_SEARXNG_HOSTS=
