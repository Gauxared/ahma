# БЕЗ СЛЕША НА КОНЦЕ — И ЭТО НЕ МЕЛОЧЬ.
#
# `node_modules/` со слешем — шаблон ТОЛЬКО ДЛЯ КАТАЛОГА. На сервере в
# сборочном каталоге лежит ССЫЛКА с этим именем (пакеты общие для выпусков,
# `deploy/release.sh`), а ссылка каталогом не является: git показывал её как
# неотслеживаемую, и гейт «сборочный каталог — копия ветки» отклонял выпуск.
# Замерено 10.09.2026 на первом же поднятии стенда.
node_modules
.env
.venv/
.superpowers/
.serena/

# Артефакты сборки
dist/
.next/
*.tsbuildinfo
coverage/
test-results/
playwright-report/

# Локальные данные и временное
var/
tmp/

# Каталог канонических позиций генерируется из открытых данных ФГИС ЦС
# командой `pnpm tsx tooling/import-fsnb.ts --fetch`. В git не хранится:
# дополнения ФСНБ выходят ежеквартально, и каждое добавляло бы в историю
# ещё 22 МБ.
config/canonical-items.json

# Крупные референсные корпуса не версионируем
reference-system-new/

# Состояния сессий сквозных наборов: их пишет проект `вход` на каждом прогоне.
# В историю они не идут — это живые куки арендатора, а не исходный код.
tests/e2e/.auth/

# Рабочие материалы владельца: картинки, архивы, выгрузки навыков. Кладутся в
# `info/` по ходу разговора и к исходному коду не относятся.
#
# ПОПАЛИ В ИСТОРИЮ ОДИН РАЗ — 11 МБ коммитом a73a144, забранные `git add -A`.
# Правило записано здесь, чтобы это не повторилось: репозиторий уже не
# версионирует крупные корпуса (`reference-system-new/`) по той же причине.
info/
