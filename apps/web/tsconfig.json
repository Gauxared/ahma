{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "jsx": "preserve",
    // База объявляет только ES2023: код платформы, воркера и CLI живёт на
    // сервере, и там `document` — опечатка, а не возможность. Веб исполняется в
    // браузере, поэтому DOM объявлен ЗДЕСЬ и только здесь: остальные пакеты
    // по-прежнему не соберутся, если потянутся к окну.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
