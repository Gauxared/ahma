{
  "id": "full-check",
  "name": "Проверка объекта целиком: такты 0–4",
  "source": "reference-system/skills/stroiintellect-master/.../references/workflow.md",
  "note": "Порядок и предусловия перенесены из легаси-протокола. Людмила НЕ параллельна Денчику: она принимает от него ВОР (ADR-R-002), несмотря на «ТАКТ 1 ПАРАЛЛЕЛЬНО» в SKILL.md — там описан чат, где человек сам чередует реплики. Тимофей добавлен десятым: график производства работ — десятый документ пакета, и он читает то же, что Артемий, отвечая на другой вопрос — «за сколько», а не «брать ли».",
  "maxRework": 2,
  "stages": [
    {
      "id": "такт-0",
      "name": "Приём (≤ 2 часов от получения задания)",
      "steps": [
        {
          "agent": "настенька",
          "produces": [
            "паспорт-объекта",
            "реестр-поручений"
          ],
          "requires": []
        }
      ]
    },
    {
      "id": "такт-1",
      "name": "Инженерный и сметный вход (День 1)",
      "steps": [
        {
          "agent": "денчик",
          "produces": [
            "вор-геометрия",
            "нагрузки",
            "спецификация"
          ],
          "requires": []
        },
        {
          "agent": "людмила",
          "produces": [
            "вор",
            "лср-маппинг",
            "конъюнктура"
          ],
          "requires": [
            "вор-геометрия:approved"
          ]
        },
        {
          "agent": "палыч",
          "produces": [
            "чеклист-старта",
            "реестр-аоср"
          ],
          "requires": []
        },
        {
          "agent": "виктор",
          "produces": [
            "аудит-договора"
          ],
          "requires": []
        }
      ]
    },
    {
      "id": "такт-2",
      "name": "Финансовая модель (День 2, ТОЛЬКО после ВОР от Людмилы)",
      "steps": [
        {
          "agent": "ваныч",
          "produces": [
            "финмодель",
            "потолки"
          ],
          "requires": [
            "вор:approved",
            "аудит-договора:approved"
          ]
        }
      ]
    },
    {
      "id": "такт-3",
      "name": "Снабжение и подряд (Дни 2–3, после потолков от Ваныча)",
      "steps": [
        {
          "agent": "марина",
          "produces": [
            "лид-тайм-карта"
          ],
          "requires": [
            "потолки:approved"
          ]
        },
        {
          "agent": "халиль",
          "produces": [
            "скоринг-субподрядчиков"
          ],
          "requires": [
            "потолки:approved"
          ]
        }
      ]
    },
    {
      "id": "такт-4",
      "name": "Синтез и вердикт (Дни 5–7)",
      "steps": [
        {
          "agent": "артемий",
          "produces": [
            "вердикт"
          ],
          "requires": [
            "финмодель:approved",
            "чеклист-старта:approved"
          ]
        },
        {
          "agent": "тимофей",
          "produces": [
            "график-работ"
          ],
          "requires": [
            "финмодель:approved",
            "потолки:approved"
          ]
        }
      ]
    }
  ]
}
