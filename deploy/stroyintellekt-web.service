[Unit]
Description=СтройИнтеллект — веб
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
# Рабочий каталог — ССЫЛКА на текущий выпуск, а не сам выпуск.
# Выпуск собирается рядом и подключается переводом ссылки: пока идёт
# сборка, служба читает прежний каталог и продолжает отвечать
# (см. deploy/release.sh).
WorkingDirectory=/opt/stroyintellekt/current
# Окружение читается файлом с правами 600: ключ модели не попадает ни в
# командную строку, ни в journalctl.
EnvironmentFile=/opt/stroyintellekt/.env
Environment=NODE_ENV=production
Environment=PORT=3000
# БЕЗ ЭТОЙ СТРОКИ HTTPS_PROXY В .env НИЧЕГО НЕ ДЕЛАЕТ.
#
# Встроенный `fetch` (undici) прокси-переменные среды сам по себе НЕ читает:
# запрос уходит напрямую, и настройка выглядит применённой, ничего не меняя.
# Задана здесь безусловно — тогда установка, которой туннель нужен, включает
# его одной переменной в .env, а установка без туннеля ничего не теряет:
# без HTTPS_PROXY агент ходит напрямую.
#
# Проверено на Node 22.23.2 сервера: с переменной — 200, без неё — 403.
Environment=NODE_USE_ENV_PROXY=1
ExecStart=/usr/bin/npx next start apps/web -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
