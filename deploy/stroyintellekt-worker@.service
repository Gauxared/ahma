[Unit]
# ШАБЛОН, А НЕ ОДИН ЮНИТ. Экземпляры: stroyintellekt-worker@1, @2 …
#
# ЗАЧЕМ ВТОРОЙ ПОТОК. Проверку ставят до пяти человек, а прогон экипажа идёт до
# часа. С одним воркером второй человек ждёт не свою работу — и ждёт молча.
#
# Число потоков названо в deploy/contours.sh (`WORKERS`), и выпуск перезапускает
# ровно столько экземпляров, сколько там сказано. Добавить третий — это
# изменить число и включить @3, а не копировать файл юнита.
Description=СтройИнтеллект — воркер фоновых задач (поток %i)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
# Рабочий каталог — ССЫЛКА на текущий выпуск, а не сам выпуск.
# Выпуск собирается рядом и подключается переводом ссылки: пока идёт
# сборка, служба читает прежний каталог и продолжает отвечать
# (см. deploy/release.sh).
WorkingDirectory=/opt/stroyintellekt/current
EnvironmentFile=/opt/stroyintellekt/.env
# НОМЕР ПОТОКА — ЭТО ИМЯ ЗАМКА.
#
# Воркер держит замок с номером процесса в дереве проекта: он существует против
# СЛУЧАЙНОГО дубля, запущенного человеком, забывшим о первом (5 сентября 2026
# таких набралось восемь, и systemd-oomd убил рабочий стол). Замок
# пер-экземплярный, поэтому законный второй поток стартует, а дубль первого —
# нет. Без этой переменной оба экземпляра взяли бы ОДНО имя замка, и второй
# отказался бы запускаться с сообщением про дубль.
Environment=STROYINTELLECT_WORKER_ID=%i
# Потолок кучи: книга Excel на 39 МБ забирает несколько гигабайт, и воркер
# обязан пережить такой файл, а не упасть на нём.
Environment=NODE_OPTIONS=--max-old-space-size=2048
# Наружу к модели ходит ИМЕННО ВОРКЕР — обход объекта идёт здесь. Пояснение к
# переменной см. в stroyintellekt-web.service: без неё HTTPS_PROXY из .env
# не действует, и встроенный `fetch` уходит напрямую.
Environment=NODE_USE_ENV_PROXY=1
ExecStart=/opt/stroyintellekt/current/node_modules/.bin/tsx apps/worker/src/main.ts
Restart=always
RestartSec=10

# ПРЕДЕЛ ПАМЯТИ НА ПОТОК — ЧТОБЫ УТЕЧКА СТОИЛА ОДНОЙ ЗАДАЧИ, А НЕ СЕРВЕРА.
#
# На машине 11,7 ГБ и НЕТ ПОДКАЧКИ: перебор памяти означает не замедление, а
# убийство процесса ядром, причём жертву ядро выбирает само — с равной
# вероятностью не виновника. Замер 10.09.2026: воркер на холостом ходу держит
# 288 МБ.
#
# 3 ГБ выше потолка кучи (2 ГБ) с запасом на буферы чтения книг вне кучи.
# То есть в обычной работе предел не достигается: первым срабатывает потолок
# V8. Предел ловит именно НЕОГРАНИЧЕННЫЙ рост — и убивает один поток, а не
# машину. Двум потокам это стоит 6 ГБ худшего случая из 11,7.
MemoryMax=3G

[Install]
WantedBy=multi-user.target
