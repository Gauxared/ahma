{
  "name": "stroyintellect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "si": "tsx apps/cli/src/main.ts",
    "dev:web": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; NODE_OPTIONS=\"--max-old-space-size=2048\" next dev apps/web --webpack'",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "worker": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; NODE_OPTIONS=--max-old-space-size=1024 tsx apps/worker/src/main.ts'",
    "build:web": "next build apps/web --webpack",
    "start:web": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; next start apps/web'",
    "build:worker": "tsc -p apps/worker/tsconfig.json",
    "test": "vitest run --project быстрый",
    "test:slow": "vitest run --project медленный",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm ресурсы && playwright test",
    "typecheck": "tsc -p tsconfig.base.json --noEmit && pnpm typecheck:web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "verify:architecture": "tsx tooling/verify-architecture.ts",
    "verify": "pnpm ресурсы && pnpm typecheck && pnpm verify:architecture && pnpm verify:contrast && pnpm test:all",
    "ресурсы": "tsx tooling/resources.ts",
    "стоп": "tsx tooling/resources.ts --стоп",
    "db:provision": "tsx tooling/provision-db-role.ts",
    "db:reset": "prisma migrate reset --force",
    "spike:structured-output": "tsx tooling/spike-structured-output.ts",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "verify:contrast": "tsx tooling/verify-contrast.ts",
    "demo:up": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; tsx tooling/demo-up.ts'",
    "hooks:install": "git config core.hooksPath tooling/hooks && echo 'хуки включены: tooling/hooks'"
  },
  "dependencies": {
    "7z-wasm": "1.2.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@openai/codex-sdk": "0.147.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.0",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "mammoth": "1.12.1",
    "next": "16.3.1",
    "node-unrar-js": "2.0.2",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prisma": "7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tsx": "4.23.12",
    "undici": "8.10.0",
    "xlsx": "0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
