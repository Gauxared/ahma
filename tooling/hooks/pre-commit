#!/bin/sh
#
# Гейты перед коммитом.
#
# ЗАЧЕМ
#
# В одном рабочем дереве работают две сессии. Дважды коммит уносил в историю
# красное состояние: у одного правка была в полёте, другой коммитил всё подряд.
# Ветка от этого не спасает — дерево общее, а `git add -A` присваивает чужое.
#
# Хук лечит последствие, которое лечится машинно: красный коммит. Само
# присвоение авторства лечится договорённостью (см. Ф-ADR-013 плана трека) —
# коммить свой инкремент сразу и не собирать в коммит то, чего не писал.
#
# Гейты выбраны по времени: каждый около секунды, вместе меньше трёх. Хук,
# который думает минуту, обходят флагом и перестают считать проверкой.
#
# Обойти осознанно: git commit --no-verify
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail=0

# Два журнала разных треков в одном коммите — точный признак того, что в
# коммит попало чужое: их ведут разные сессии и по разным поводам.
if echo "$staged" | grep -q '^docs/roadmap-fact\.md$' && echo "$staged" | grep -q '^docs/roadmap-frontend-fact\.md$'; then
  echo "  ✗ в коммите журналы обоих треков: похоже, собрана чужая работа"
  echo "    разложите по коммитам или подтвердите: git commit --no-verify"
  fail=1
fi

if echo "$staged" | grep -qE '\.tsx?$|\.css$|\.json$'; then
  pnpm -s verify:architecture || fail=1
  pnpm -s verify:contrast || fail=1
fi

if echo "$staged" | grep -q '^apps/web/'; then
  pnpm -s typecheck:web >/dev/null || { echo "  ✗ typecheck:web падает"; fail=1; }
fi

[ "$fail" -eq 0 ] || {
  echo ""
  echo "Коммит остановлен: сначала зелёное состояние."
  exit 1
}
